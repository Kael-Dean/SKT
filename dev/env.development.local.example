# SKT-dev only — copy to .env.development.local (gitignored).
# Dev server routes API calls through the Vite proxy in vite.config.js
# because backend CORS may reject http://localhost origins.
# Proxy target = staging backend (not production).
VITE_API_BASE_CUSTOM=/api-proxy
VITE_API_BASE=/api-proxy
DEV_PROXY_TARGET=https://um-backend-staging-243977022740.asia-southeast1.run.app
